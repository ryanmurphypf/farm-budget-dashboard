# Copy to .env.local for local development

# Dashboard login password (default: PetersonFarms2026!)
DASHBOARD_PASSWORD=YourSecurePassword

# JWT signing secret — generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=your-random-secret-here

# SQLite database directory
# Local: leave unset (defaults to ./data)
# Railway: set to /data and mount a Volume at /data
DATABASE_DIR=/data
