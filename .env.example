# Copy to .env.local for local development

# PostgreSQL connection string (required)
# Get this from Railway: your project → Postgres service → Connect tab → copy DATABASE_URL
DATABASE_URL=postgresql://postgres:password@hostname:5432/railway

# Dashboard login password (default: PetersonFarms2026!)
DASHBOARD_PASSWORD=YourSecurePassword

# JWT signing secret — generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=your-random-secret-here
